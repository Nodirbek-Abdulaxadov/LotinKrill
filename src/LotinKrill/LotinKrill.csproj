<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>LotinKrill</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>LotinKrill</PackageId>
    <Version>1.0.1</Version>
    <Description>O'zbek tili uchun lotin ↔ kirill transliteratori: barcha apostrof turlari, katta harfli matn, ц/ь/э/ё istisno lug'atlari.</Description>
    <PackageTags>uzbek;transliteration;transliterator;cyrillic;latin;o'zbek;lotin;kirill</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
